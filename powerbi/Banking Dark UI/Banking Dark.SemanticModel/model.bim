        "lineageTag": "e8a5bd4a-d13f-45a3-bfbb-227c0c7432f2",
        "measures": [
          {
            "name": "Bank Loan Amount",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Bank Loan])",
            "lineageTag": "a309c182-223d-49ff-804c-bc63f110d27e"
          },
          {
            "name": "Business Lending Amount",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Business Lending])",
            "lineageTag": "6431e295-db4c-48bf-bacb-1c055cdb4076"
          },
          {
            "name": "Credit Cards Balance",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Credit Card Balance])",
            "lineageTag": "62bf53ff-2c33-46a6-b617-61b9719abf70"
          },
          {
            "name": "Total Bank Deposit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Bank Deposit])",
            "lineageTag": "16eae785-2fbc-44e3-9639-131743e006ea"
          },
          {
            "name": "Total Checking Accounts",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Checking Account])",
            "lineageTag": "e8afa468-a5cc-4b89-8e5b-7cdc59de3ff4"
          },
          {
            "name": "Total Saving Account",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Saving Account])",
            "lineageTag": "bd727e24-ff3a-4710-b62a-c65107c0e258"
          },
          {
            "name": "Foreign Currency Amount",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Banking'[Foreign Currency Account])",
            "lineageTag": "b1b2ba9f-a070-45f2-9446-8784373d6cd5"
          },
          {
            "name": "Engagement Length",
            "expression": "SUM('Banking'[Engagement days])",
            "formatString": "0",
            "lineageTag": "95c0e51b-401f-4d94-a71e-4e6e175eff4d"
          },
          {
            "name": "Total Loan",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "[Bank Loan Amount] + [Business Lending Amount] + [Credit Cards Balance]",
            "lineageTag": "274f975f-ae97-4b01-ae6d-9674249894bd"
          },
          {
            "name": "Total Deposit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "[Total Bank Deposit] + [Total Saving Account] + [Total Checking Accounts] + [Foreign Currency Amount]",
            "lineageTag": "78b9369e-f24d-4f5c-908d-6f949fcd083e"
          },
          {
            "name": "Total Fees",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUMX('Banking', [Total Loan] * 'Banking'[Processing fees])",
            "lineageTag": "36aec22e-5865-4119-9cf2-168355784f52"
          },
          {
            "name": "Total CC Amount",
            "expression": "SUM('Banking'[Credit Card Count])",
            "formatString": "0",
            "lineageTag": "a4251340-8ffb-4fd2-95b4-1b47fd8fda23"
          },
          {
            "name": "Avg Loan Per Client",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Loan], DISTINCTCOUNT('Banking'[Client ID]))",
            "lineageTag": "856c389b-131b-4f14-a8bd-4f771a6380a8"
          },
          {
            "name": "Avg Deposit Per Client",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Deposit], DISTINCTCOUNT('Banking'[Client ID]))",
            "lineageTag": "7ea510d5-5fa1-4377-8c93-48569d50bd22"
          },
          {
            "name": "Loan to Deposit Ratio",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Loan], [Total Deposit])",
            "lineageTag": "a4bf1f70-32f5-47c7-bad6-89cb6cea6b5e"
          },
          {
            "name": "YoY Loan Growth",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "IF(",
              "    HASONEVALUE('Date Table'[Year]),",
              "    DIVIDE(",
              "        CALCULATE([Bank Loan Amount], 'Date Table'[Year] = MAX('Date Table'[Year])) - ",
              "        CALCULATE([Bank Loan Amount], 'Date Table'[Year] = MAX('Date Table'[Year]) - 1),",
              "        CALCULATE([Bank Loan Amount], 'Date Table'[Year] = MAX('Date Table'[Year]) - 1)",
              "    ),",
              "    BLANK()",
              ")"
            ],
            "lineageTag": "c1347d4d-0c61-4b43-aef6-d5289f2b8753"
          },
          {
            "name": "YoY Deposit Growth",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "IF(",
              "    HASONEVALUE('Date Table'[Year]),",
              "    DIVIDE(",
              "        CALCULATE([Total Deposit], 'Date Table'[Year] = MAX('Date Table'[Year])) - ",
              "        CALCULATE([Total Deposit], 'Date Table'[Year] = MAX('Date Table'[Year]) - 1),",
              "        CALCULATE([Total Deposit], 'Date Table'[Year] = MAX('Date Table'[Year]) - 1)",
              "    ),",
              "    BLANK()",
              ")"
            ],
            "lineageTag": "2820a7c6-5189-4b0c-86d7-e833bb0f9a89"
          },
          {
            "name": "YoY Client Growth",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), SAMEPERIODLASTYEAR('Date Table'[Date])), CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), PREVIOUSYEAR('Date Table'[Date])))",
            "lineageTag": "2b2c2614-0b78-468a-b9e8-d64fe5ddee0c"
          },
          {
            "name": "Cumulative Clients",
            "expression": "CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), FILTER(ALL('Date Table'), 'Date Table'[Date] <= MAX('Date Table'[Date])))",
            "formatString": "0",
            "lineageTag": "09f54320-840f-40d2-b524-b81e994ef238"
          },
          {
            "name": "High Value Clients",
            "expression": "CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), 'Banking'[Income Band] = \"High\")",
            "formatString": "0",
            "lineageTag": "db5a1d2f-cc6e-4096-9d15-5882fe44200d"
          },
          {
            "name": "Avg Properties Owned",
            "expression": "AVERAGE('Banking'[Properties Owned])",
            "formatString": "0",
            "lineageTag": "24ef172b-ddc9-4ac8-89d8-f0cd768ea0a8"
          },
          {
            "name": "High Income Clients",
            "expression": "CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), 'Banking'[Income Band] = \"High\")",
            "formatString": "0",
            "lineageTag": "7f4fec1b-c70b-426a-b854-aaf0aefe0a10"
          },
          {
            "name": "Low Income Clients",
            "expression": "CALCULATE(DISTINCTCOUNT('Banking'[Client ID]), 'Banking'[Income Band] = \"Low\")",
            "formatString": "0",
            "lineageTag": "bbc1995c-3a31-44dd-a302-f2e113ba080e"
          },
          {
            "name": "Total Clients",
            "expression": "DISTINCTCOUNT('Banking'[Client ID])",
            "formatString": "0",
            "lineageTag": "1069196d-f0da-46fc-bbe2-23444b92910c"
          },
          {
            "name": "High Risk Loan Clients",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Banking'[Client ID]),",
              "    'Banking'[Bank Loan] > AVERAGE('Banking'[Bank Loan])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "d16bbf82-a3a8-4399-910c-773c67fe5558"
          },
          {
            "name": "Overleveraged Clients",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Banking'[Client ID]),",
              "    'Banking'[Bank Loan] > 'Banking'[Bank Deposit]",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "da4fbb1d-79db-4a76-a74e-2319525a8b93"
          },
          {
            "name": "Credit Risk Ratio",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Credit Cards Balance], [Total Loan])",
            "lineageTag": "26e14906-baf8-4a39-8d60-1a457e6f5bd0"
          },
          {
            "name": "High Loan Low Income Count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Banking'[Client ID]),",
              "    'Banking'[Income Band] = \"Low\",",
              "    'Banking'[Bank Loan] > AVERAGE('Banking'[Bank Loan])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "0ea08e94-502a-4b26-9fe0-5199128fe3f5"
          },
          {
            "name": "Avg Loan by Income Band",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Bank Loan Amount], [Total Clients])",
            "lineageTag": "83460c48-bd42-4204-a7a6-c28fcb1718d2"
          },
          {
            "name": "Growth Rate %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Clients] - CALCULATE([Total Clients], PREVIOUSYEAR('Date Table'[Date])), CALCULATE([Total Clients], PREVIOUSYEAR('Date Table'[Date])))",
            "lineageTag": "22e2b7ad-4042-41ec-9312-f63fadaac2b3"
          },
          {
            "name": "Avg Fee Per Client",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Fees], [Total Clients])",
            "lineageTag": "41355ada-ebc5-4646-a3b6-2dd6ffa0de0b"
          },
          {
            "name": "Revenue per Loan",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Fees], [Total Loan])",
            "lineageTag": "b5815a5b-b334-4eae-949e-828f86bd7e80"
          },
          {
            "name": "Fee Concentration %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Total Fees], CALCULATE([Total Fees], ALL('Banking')))",
            "lineageTag": "03f93f15-b19d-4b50-9386-3152ae270371"
          },
          {
            "name": "Loan Concentration %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "DIVIDE([Bank Loan Amount], CALCULATE([Bank Loan Amount], ALL('Banking')))",
            "lineageTag": "30457bfd-04f6-4e33-97a0-50fa377148dd"
          }
        ],
